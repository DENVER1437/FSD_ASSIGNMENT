# NestMatch Server Environment Configuration Template
# Duplicate this file as .env and fill in required values for your environment.
# WARNING: NEVER commit actual secret credentials or real .env files to Git.

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Standardized single variable):
# For local development with local MongoDB: mongodb://127.0.0.1:27017/nestmatch
# For MongoDB Atlas (production/cloud):     mongodb+srv://<username> : <password> @ <cluster>.mongodb.net/nestmatch?retryWrites=true&w=majority
MONGODB_URI=replace_with_your_mongodb_atlas_or_local_connection_string

# JWT Secret: Minimum 32 characters, preferably a 64-byte random hex string
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key
JWT_EXPIRES_IN=7d

# Allowed Client Origins (Comma-separated list):
CLIENT_URL=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
