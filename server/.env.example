# NestMatch Server Environment Configuration Template
# Duplicate this file as .env and fill in required values for local development.
# WARNING: NEVER commit actual secret credentials or real .env files to Git.

PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# Local development: mongodb://127.0.0.1:27017/nestmatch
# Production Atlas:  replace_with_your_mongodb_atlas_connection_string
MONGODB_URI=replace_with_your_local_or_atlas_connection_string
MONGO_URI=replace_with_your_local_or_atlas_connection_string

# JWT Secret (Generate a strong 64-character random key for production):
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key
JWT_EXPIRES_IN=7d

# Allowed Client Origin (Vite frontend):
CLIENT_URL=http://localhost:5173
